<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The scene's default tag map is validated by the tests. -->
    <Content Include="..\..\src\FactorySim.App\tagmap.json" Link="tagmap.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The asset catalogue and the built-in scenes are validated too. -->
    <Content Include="..\..\src\FactorySim.App\library\catalog.json" Link="catalog.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\FactorySim.App\scenes\mvp_sorting.fsscene.json" Link="mvp_sorting.fsscene.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\FactorySim.App\scenes\assembly_line.fsscene.json" Link="assembly_line.fsscene.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The example building blocks (plan 18). -->
    <Content Include="..\..\src\FactorySim.App\library\blocks\*.fsblock.json" LinkBase="blocks" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\codesys\acceptatie\IO.gvl.st" Link="IO.gvl.st" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FactorySim.Core\FactorySim.Core.csproj" />
  </ItemGroup>

</Project>
