
(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
PROGRAM PLC_PRG
VAR
	bRun		: BOOL;				(* installatie in bedrijf *)
	nStep		: INT := 0;			(* 0 = transport, 10 = duwen, 20 = terug *)
	tonPush		: TON;				(* bewaking: pusher haalt eindstand niet *)
	bFault		: BOOL;
	nSorted		: UINT;				(* aantal uitgesorteerde dozen *)
END_VAR
(* @END_DECLARATION := '0' *)
(* --- Start/stop: stop dominant, alleen als de simulatie draait --- *)
IF iStop OR NOT iSimRunning OR bFault THEN
	bRun := FALSE;
ELSIF iStart THEN
	bRun := TRUE;
END_IF;

(* Fout resetten met Start terwijl Stop is losgelaten *)
IF bFault AND iStart AND NOT iStop THEN
	bFault := FALSE;
	nStep := 0;
END_IF;

(* --- Sorteerstap --- *)
CASE nStep OF
	0:	(* transport *)
		IF bRun AND iAtPusher AND iHighBox AND iPusherBack THEN
			nStep := 10;
		END_IF;
	10:	(* band stil, pusher uit *)
		IF iPusherFront THEN
			nSorted := nSorted + 1;
			nStep := 20;
		END_IF;
	20:	(* pusher terug *)
		IF iPusherBack THEN
			nStep := 0;
		END_IF;
END_CASE;

(* Bewaking: pusher moet binnen 3 s zijn eindstand halen *)
tonPush(IN := (nStep = 10) OR (nStep = 20), PT := T#3s);
IF tonPush.Q THEN
	bFault := TRUE;
	nStep := 0;
END_IF;

(* --- Uitgangen --- *)
oConveyor := bRun AND (nStep = 0);
oPusher := (nStep = 10);
oEmitter := bRun;
oRunLamp := bRun;
wSorted := UINT_TO_WORD(nSorted);
END_PROGRAM

(* @NESTEDCOMMENTS := 'Yes' *)
(* @GLOBAL_VARIABLE_LIST := 'Globale_Variablen' *)
(* @PATH := '' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
VAR_GLOBAL
	(* Ingangen *)
	iStart			AT %IX0.0 : BOOL;	(* startknop *)
	iStop			AT %IX0.1 : BOOL;	(* stopknop *)
	iAtPusher		AT %IX0.2 : BOOL;	(* photo-eye bij de pusher *)
	iHighBox		AT %IX0.3 : BOOL;	(* hoge photo-eye *)
	iPusherBack		AT %IX0.4 : BOOL;	(* pusher ingetrokken *)
	iPusherFront	AT %IX0.5 : BOOL;	(* pusher uitgeschoven *)
	iSimRunning		AT %IX0.6 : BOOL;	(* simulatie draait *)

	(* Uitgangen *)
	oConveyor		AT %QX0.0 : BOOL;	(* band aan *)
	oPusher			AT %QX0.1 : BOOL;	(* pusher uit *)
	oEmitter		AT %QX0.2 : BOOL;	(* dozen spawnen *)
	oRunLamp		AT %QX0.3 : BOOL;	(* lamp in bedrijf *)
	wSorted			AT %QW2 : WORD;		(* teller *)
END_VAR

(* @OBJECT_END := 'Globale_Variablen' *)
